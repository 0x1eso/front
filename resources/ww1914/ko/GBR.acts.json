  "aims": {
    "gbr_aim_belgium": {
      "name": "벨기에를 되찾는다",
      "text": "벨기에가 잃은 것을 다 되찾을 때까지 이 나라는 칼을 넣지 않겠소. 조약 한 장이 이 전쟁의 까닭이오.",
      "met": "벨기에는 되찾았다. 그 일에 든 것은 긴 명단이었다. 약속은 지켜졌다.",
      "unmet": "벨기에는 끝까지 되찾지 못했다. 그날의 연설은 스크랩으로 남았다."
    },
    "gbr_aim_win": {
      "name": "끝까지 이긴다",
      "text": "이 전쟁을 무승부로 끝내면 다음 세대가 다시 싸우게 되오. 이기는 것 말고 다른 끝은 말하지 않겠소.",
      "met": "영국은 이겼다. 끝까지 간다는 말은 지켜졌고, 그 말의 값을 세는 일은 이제 시작이다.",
      "unmet": "이기겠다고 말한 전쟁은 그렇게 끝나지 않았다. 사람들은 그 말을 기억했다."
    },
    "gbr_aim_sea": {
      "name": "바다와 제국을 지킨다",
      "text": "영국은 대륙의 나라가 아니오. 바다가 이 나라의 빵이고 돈이오. 바다를 지키고 빚 없이 끝내겠소.",
      "met": "바다는 지켰고 금고는 비지 않았다. 대륙의 일은 대륙이 치렀다는 말을 들었다.",
      "unmet": "바다든 금고든 하나가 무너졌다. 섬나라의 계산은 맞지 않았다."
    },
    "gbr_aim_peace": {
      "name": "전쟁 밖에 머문다",
      "text": "유럽의 싸움에 이 나라 젊은이를 보낼 까닭을 찾지 못했소. 전쟁 밖에 머물고, 때가 오면 런던에서 양쪽을 앉히겠소.",
      "met": "영국은 끝까지 밖에 머물렀다. 살아서 집에 돌아온 사람들은 그것이 왜 이상한지 몰랐다.",
      "unmet": "밖에 머물겠다던 나라가 들어갔다. 그 선언을 인용하는 의원이 끝까지 있었다."
    },
    "gbr_aim_ireland": {
      "name": "아일랜드를 푼다",
      "text": "아일랜드를 풀지 못하면 이 정부가 무엇을 해도 소용없소. 내 시간을 먼저 거기 쓰겠소.",
      "met": "아일랜드 문제는 풀렸다. 양쪽 모두 불만이었고, 그것이 풀렸다는 증거였다.",
      "unmet": "아일랜드는 풀리지 않았다. 다음 총리가 그 지도를 물려받았다."
    },
    "gbr_aim_liberal": {
      "name": "자유당의 영국을 지킨다",
      "text": "이기고 나서 다른 나라가 되어 있으면 무엇을 얻은 것이오? 강제 징집 없이, 이 의자를 지키며 끝내겠소.",
      "met": "자유당의 영국은 끝까지 살아남았다. 그 값을 묻는 사람들이 많았다.",
      "unmet": "전쟁은 자유당의 영국을 그냥 두지 않았다. 원칙은 한 번에 하나씩 나갔다."
    }
  }
}
